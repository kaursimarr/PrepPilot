# Copy this file to '.env' and fill in your actual credentials.

# AWS RDS PostgreSQL Connection Settings
PGHOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=preppilot
PGUSER=postgres
PGPASSWORD=your-secure-password
